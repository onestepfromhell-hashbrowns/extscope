{
  "$schema": "urn:extscope:schema:harness-adapter-v1",
  "harness_id": "codex-host",
  "name": "OpenAI Codex Host Harness",
  "version": "1.1.0",
  "projections": {
    "skills": {
      "mode": "symlink_children",
      "target_dir": "~/skills"
    },
    "rules": {
      "mode": "symlink_children",
      "target_dir": "~/rules"
    },
    "fragments": {
      "mode": "md_block_append",
      "target_file": "~/AGENTS.md"
    },
    "mcp": {
      "mode": "toml_mcp_merge",
      "target_file": "~/config.toml"
    }
  },
  "runtime_bootstrap": {
    "ensure_workspace_trust": {
      "enabled": true,
      "config_file": "~/config.toml",
      "trusted_paths": [
        "./"
      ]
    }
  }
}
